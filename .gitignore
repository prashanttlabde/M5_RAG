# LLM cache (local only; do not commit live cache unless a phase explicitly says to)
data/cache/*
!data/cache/.gitkeep

# Raw official page text (re-downloadable with `make rag`; chunks.jsonl keeps the cited passages)
data/sources/*.txt

# Intermediate scrape file (cleaned CSVs are the source of truth)
data/reviews_raw.csv

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
